<UserControl
    x:Class="IptvPlayer.Dialogs.LicenseStatusDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Width="420" Padding="8">
        <TextBlock Text="&#xEC4B;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock x:Name="StatusHeader" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextAlignment="Center"/>

        <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap"
                   TextAlignment="Center" IsTextSelectionEnabled="True"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <Button x:Name="ActivateButton" x:FieldModifier="private"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Center" Margin="0,4,0,0"
                Click="ActivateButton_Click"/>
    </StackPanel>
</UserControl>
