<UserControl
    x:Class="IptvPlayer.Dialogs.EpgSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Width="480">
        <TextBlock x:Name="TitleText" x:Uid="Nastroyki_EPG" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="12">

                <TextBlock x:Name="RemindersHeader" x:Uid="Napominaniya_EPG" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="RemindersHint"
                           x:Uid="Za_Skolko_Minut_Do_Nachala_Peredachi"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="ReminderMinutesCombo" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="EpgRefreshHeader" x:Uid="EPG_Programma_Peredach" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock x:Name="EpgRefreshHint"
                           x:Uid="Kak_Chasto_Pri_Zapuske_Perekachivat_XMLTV"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="EpgRefreshCombo" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="EpgArchiveHeader" x:Uid="Glubina_Arkhiva" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock x:Name="EpgArchiveHint"
                           x:Uid="Skolko_Dney_Nazad_Khranit_Peredachi"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="EpgArchiveCombo" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    x:Uid="Otmena"
                    Width="100" Height="36"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    x:Uid="Sokhranit"
                    Width="100" Height="36"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
