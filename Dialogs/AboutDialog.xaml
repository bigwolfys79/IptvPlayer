<UserControl
    x:Class="IptvPlayer.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка (всегда видна) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="14,8">
                <TextBlock Text="IPTV" Foreground="White" FontWeight="Bold" FontSize="16"/>
            </Border>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="IptvPlayer" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Прокручиваемое тело (описание, компоненты, пути, статус) -->
        <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                      Margin="0,6,0,0">
            <StackPanel Spacing="10">
                <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"/>

                <TextBlock x:Name="FeaturesHeader" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="FeaturesText" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock x:Name="ComponentsHeader" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ComponentsText" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock x:Name="PathsHeader" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="PathsText" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock x:Name="UpdateStatusText" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки (всегда видны внизу, не уезжают при прокрутке) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button x:Name="CheckUpdateButton" Click="CheckUpdateButton_Click"/>
            <Button x:Name="LicenseButton" Click="LicenseButton_Click"/>
            <Button x:Name="OpenLogsButton" Click="OpenLogsButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
