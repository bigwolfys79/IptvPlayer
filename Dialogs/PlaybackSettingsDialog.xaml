<UserControl
    x:Class="IptvPlayer.Dialogs.PlaybackSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Быстрый доступ к разделу воспроизведения полного SettingsDialog:
         декодер, буфер, качество, аудио и видео-фильтры. Радиогруппы и
         комбобоксы наполняются в code-behind (LoadAsync) с Tag-значениями. -->
    <StackPanel Spacing="12" Width="480">
        <TextBlock x:Name="TitleText" x:Uid="Nastroyki_Vosproizvedeniya" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="16">

                <!-- Декодер -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DecoderHeader" x:Uid="Dekodirovanie_Video" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DecoderHint"
                               x:Uid="Primenitsya_Pri_Sleduyushchem_Pereklyuchenii_Kanala"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <RadioButtons x:Name="DecoderRadio"/>
                </StackPanel>

                <!-- Буфер -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BufferHeader" x:Uid="Buferizatsiya" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BufferHint"
                               x:Uid="Primenitsya_Pri_Sleduyushchem_Pereklyuchenii_Kanala"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <Slider x:Name="BufferSlider"
                            Minimum="5" Maximum="60" StepFrequency="1"
                            Width="320" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="BufferValueText"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <!-- Буфер видеотеки (портал): отдельно от эфирного —
                         короткий ради быстрого старта фильмов. -->
                    <TextBlock x:Name="VodBufferHeader" x:Uid="Bufer_Videoteki" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="VodBufferHint"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <Slider x:Name="VodBufferSlider"
                            Minimum="2" Maximum="15" StepFrequency="1"
                            Width="320" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="VodBufferValueText"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Качество -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="QualityHeader" x:Uid="Kachestvo_Video" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="QualityHint"
                               x:Uid="Maksimalnoe_Kachestvo_Potoka_Ili_Ogranichenie_Razresheniya"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Аудио -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AudioHeader" x:Uid="Zvuk" FontSize="14" FontWeight="SemiBold"/>

                    <TextBlock x:Name="AudioNormHeader" x:Uid="Normalizatsiya_Gromkosti" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AudioNormHint"
                               x:Uid="Podtyagivaet_Tikhie_Kanaly_K_Obshchemu_Urovnyu"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <RadioButtons x:Name="AudioNormRadio"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки вне ScrollViewer: видны всегда, не уезжают при прокрутке. -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    x:Uid="Otmena"
                    Width="100" Height="36"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    x:Uid="Sokhranit"
                    Width="100" Height="36"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
