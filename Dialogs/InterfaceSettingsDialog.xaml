<UserControl
    x:Class="IptvPlayer.Dialogs.InterfaceSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Width="480">
        <TextBlock x:Name="TitleText" x:Uid="Nastroyki_Interfeysa" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="16">

                <StackPanel Spacing="8">
                    <TextBlock x:Name="LanguageHeader" x:Uid="YAzyk_Interfeysa" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LanguageHint"
                               x:Uid="Osnovnye_Teksty_Interfeysa_Perevodyatsya_Na_Letu"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <ComboBox x:Name="LanguageCombo" MinWidth="180" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="ThemeHeader" x:Uid="Tema_Interfeysa" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThemeHint"
                               x:Uid="Primenyaetsya_Srazu_Posle_Sokhraneniya_Bez_Perezapuska"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <RadioButtons x:Name="ThemeRadio"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="SleepTimerHeader" x:Uid="Taymer_Sna_Po_Istechenii" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SleepTimerHint"
                               x:Uid="Primenyaetsya_K_Uzhe_Vzvedennomu_Taymeru_Deystvie"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <ComboBox x:Name="SleepTimerActionCombo" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="MinimizeToTrayHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="CloseToTrayToggle" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CloseToTrayHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="AutoUpdateToggle" HorizontalAlignment="Left" Toggled="AutoUpdateToggle_Toggled"/>
                    <TextBlock x:Name="AutoUpdateHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ShowHubOnStartupToggle" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ShowHubOnStartupHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="OnlineCinemaToggle" HorizontalAlignment="Left" Toggled="OnlineCinemaToggle_Toggled"/>
                    <TextBlock x:Name="OnlineCinemaHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="OnlineCinemaRefreshHeader" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OnlineCinemaRefreshHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <NumberBox x:Name="OnlineCinemaRefreshBox" MinWidth="180" HorizontalAlignment="Left"
                               Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact" SmallChange="5"/>
                    <TextBlock x:Name="OnlineCinemaCollectHeader" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OnlineCinemaCollectHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <NumberBox x:Name="OnlineCinemaCollectBox" MinWidth="180" HorizontalAlignment="Left"
                               Minimum="30" Maximum="7200" SpinButtonPlacementMode="Compact" SmallChange="30"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    x:Uid="Otmena"
                    Width="100" Height="36"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    x:Uid="Sokhranit"
                    Width="100" Height="36"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
