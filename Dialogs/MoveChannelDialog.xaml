<UserControl
    x:Class="IptvPlayer.Dialogs.MoveChannelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <StackPanel Width="420" Spacing="12">
        <TextBlock x:Name="ChannelNameText" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HintText" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <ComboBox x:Name="GroupCombo"
                  IsEditable="True"
                  HorizontalAlignment="Stretch"
                  MaxDropDownHeight="320" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Width="110" Height="34" Click="CancelButton_Click" />
            <Button x:Name="MoveButton" Width="110" Height="34"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="MoveButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
