<UserControl
    x:Class="IptvPlayer.Dialogs.OnlineCinemaSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Width="480">
        <TextBlock x:Name="TitleText" x:Uid="OnlineCinema_Settings" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="16">

                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="CinemaEnabledToggle" HorizontalAlignment="Left" Toggled="CinemaEnabledToggle_Toggled"/>
                    <TextBlock x:Name="CinemaEnabledHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="RefreshHeader" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RefreshHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <NumberBox x:Name="RefreshBox" MinWidth="180" HorizontalAlignment="Left"
                               Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact" SmallChange="5"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="CollectHeader" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CollectHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <NumberBox x:Name="CollectBox" MinWidth="180" HorizontalAlignment="Left"
                               Minimum="30" Maximum="7200" SpinButtonPlacementMode="Compact" SmallChange="30"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="ParsingHeader" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ParsingHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="UseCurlToggle" HorizontalAlignment="Left" Toggled="MethodToggle_Toggled"/>
                    <TextBlock x:Name="UseCurlHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="UseHttpClientToggle" HorizontalAlignment="Left" Toggled="MethodToggle_Toggled"/>
                    <TextBlock x:Name="UseHttpClientHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="UseWebView2Toggle" HorizontalAlignment="Left" Toggled="MethodToggle_Toggled"/>
                    <TextBlock x:Name="UseWebView2Hint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    x:Uid="Otmena"
                    Width="100" Height="36"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    x:Uid="Sokhranit"
                    Width="100" Height="36"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
