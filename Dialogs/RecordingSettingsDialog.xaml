<UserControl
    x:Class="IptvPlayer.Dialogs.RecordingSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Записи: идущие и запланированные (стоп/отмена), папка сохранения. -->
    <StackPanel Spacing="12" Width="480">
        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="4" Spacing="12">

                <TextBlock x:Name="ActiveHeader" FontSize="14" FontWeight="SemiBold"/>
                <StackPanel x:Name="ActiveList" Spacing="4"/>

                <TextBlock x:Name="ScheduledHeader" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <StackPanel x:Name="ScheduledList" Spacing="4"/>

                <TextBlock x:Name="FolderHeader" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock x:Name="FolderHint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="FolderBox" Width="310"/>
                    <Button x:Name="BrowseButton" Height="32" Padding="12,0" Click="BrowseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки вне ScrollViewer: видны всегда, не уезжают при прокрутке. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click"/>
            <Button x:Name="SaveButton" Height="36" Padding="16,0"
                    Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
