<UserControl
    x:Class="IptvPlayer.Dialogs.EpisodePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IptvPlayer.Dialogs"
    xmlns:converters="using:IptvPlayer.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- Выбор серии сериала портала: шапка с постером/описанием и
         виртуализованный список эпизодов (их могут быть сотни). -->
    <StackPanel Width="520" MaxHeight="640" Spacing="12">
        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12">
            <Image x:Name="PosterImage" Width="92" Height="138" Stretch="UniformToFill"
                   VerticalAlignment="Top"/>
            <StackPanel Spacing="4" VerticalAlignment="Top" Margin="0,0,8,0">
                <TextBlock x:Name="SerialTitleText" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EpisodesCountText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SerialDescriptionText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- Сезон — соседние карточки каталога («Название. Сезон N»); серия —
             список выбранного сезона (подгружается flick'ом при смене). -->
        <StackPanel x:Name="SeasonPanel" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="SeasonLabel" x:Uid="Sezon" FontSize="13" VerticalAlignment="Center"/>
            <ComboBox x:Name="SeasonCombo" MinWidth="160" SelectionChanged="SeasonCombo_SelectionChanged"/>
            <ProgressRing x:Name="SeasonLoading" Width="20" Height="20" Visibility="Collapsed"/>
        </StackPanel>

        <ListView x:Name="EpisodesList"
                  MaxHeight="380"
                  ItemsSource="{x:Bind Episodes}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="EpisodeItem_Click">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EpisodePickerItem">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,6">
                        <TextBlock Text="{x:Bind Number}" FontSize="14" FontWeight="SemiBold"
                                   MinWidth="34" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="{x:Bind Title}" FontSize="14"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" x:Uid="Otmena" Width="110" Height="34" Click="CancelButton_Click"/>
            <Button x:Name="PlayFirstButton" x:Uid="Smotret_S_Pervoy"
                    Width="170" Height="34" Style="{ThemeResource AccentButtonStyle}"
                    Click="PlayFirstButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
