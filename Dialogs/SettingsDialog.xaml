<UserControl
    x:Class="IptvPlayer.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IptvPlayer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Диалог настроек с вкладками: Воспроизведение / Интерфейс / EPG / Дополнительно -->
    <StackPanel Spacing="12" Width="480">

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>

        <Pivot x:Name="SettingsPivot">
            <!-- Вкладка: Воспроизведение -->
            <PivotItem x:Name="PlaybackTab" Header="Воспроизведение">
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBlock x:Name="DecoderHeader" FontSize="12" FontWeight="Medium"/>
                        <RadioButtons x:Name="DecoderRadio"/>
                        <TextBlock x:Name="DecoderHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock x:Name="BufferHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <Slider x:Name="BufferSlider" Minimum="5" Maximum="60" StepFrequency="5" TickFrequency="5"
                                Width="300" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="BufferValueText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="BufferHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock x:Name="QualityHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="QualityHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock x:Name="AudioNormHeader" FontSize="12" FontWeight="Medium" Margin="0,12,0,0"/>
                        <RadioButtons x:Name="AudioNormRadio"/>
                        <TextBlock x:Name="AudioNormHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Вкладка: Интерфейс -->
            <PivotItem x:Name="InterfaceTab" Header="Интерфейс">
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBlock x:Name="LanguageHeader" FontSize="12" FontWeight="Medium"/>
                        <ComboBox x:Name="LanguageCombo" MinWidth="180" HorizontalAlignment="Left"/>

                        <TextBlock x:Name="ThemeHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <RadioButtons x:Name="ThemeRadio"/>

                        <TextBlock x:Name="SleepTimerActionHeader" FontSize="12" FontWeight="Medium" Margin="0,12,0,0"/>
                        <ComboBox x:Name="SleepTimerActionCombo" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="SleepTimerActionHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Вкладка: EPG -->
            <PivotItem x:Name="EpgTab" Header="EPG">
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBlock x:Name="EpgSourcesHeader" FontSize="12" FontWeight="Medium"/>
                        <ItemsControl ItemsSource="{x:Bind EpgSources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:EPGSource">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"/>
                                        <TextBlock Text="{x:Bind Url}" Width="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Content="✕" Width="32" Height="32" Click="RemoveEpgSourceButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="EpgUrlBox" Width="320"/>
                            <Button x:Name="AddEpgSourceButton" Content="+" Width="32" Height="32" Click="AddEpgSourceButton_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="RemindersHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <ComboBox x:Name="ReminderMinutesCombo" HorizontalAlignment="Stretch"/>

                        <TextBlock x:Name="EpgRefreshHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <ComboBox x:Name="EpgRefreshCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Вкладка: Дополнительно -->
            <PivotItem x:Name="AdvancedTab" Header="Дополнительно">
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBlock x:Name="PlaylistHeader" FontSize="12" FontWeight="Medium"/>
                        <ComboBox x:Name="PlaylistRefreshCombo" HorizontalAlignment="Stretch"/>

                        <TextBlock x:Name="RecordingsFolderHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="RecordingsFolderBox" HorizontalAlignment="Stretch" Width="300"/>
                            <Button x:Name="ChooseRecordingsFolderButton" Click="ChooseRecordingsFolderButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RecordingsFolderHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                        <TextBlock x:Name="M3uHeader" FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
                        <TextBox x:Name="PlaylistUrlBox"/>
                        <TextBlock x:Name="PlaylistStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                        <Button x:Name="AddPlaylistButton" HorizontalAlignment="Left" Click="AddPlaylistButton_Click"/>

                        <TextBlock x:Name="DiagnosticsHeader" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <ToggleSwitch x:Name="FileLoggingToggle" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FileLoggingHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="StatsOverlayToggle" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StatsOverlayHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                        <TextBlock x:Name="ImportExportHeader" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock x:Name="ImportExportHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <Button x:Name="ExportButton" Click="ExportButton_Click"/>
                            <Button x:Name="ImportButton" Click="ImportButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportExportStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button x:Name="ResetButton" Click="ResetButton_Click"/>
                            <Button x:Name="AboutButton" Click="AboutButton_Click"/>
                        </StackPanel>

                        <Border x:Name="AboutPanel" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="8" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AboutText" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </StackPanel>
</UserControl>
