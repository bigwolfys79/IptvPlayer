<UserControl
    x:Class="IptvPlayer.Dialogs.PlaylistSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IptvPlayer.Models"
    xmlns:dialogs="using:IptvPlayer.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Управление плейлистами: список источников (активный отмечен, кнопка
         «Активировать» переключает список каналов), добавление нового
         (имя необязательное — по умолчанию хост URL) и удаление.
         Частота обновления — общая на все плейлисты. -->
    <StackPanel Spacing="12" Width="480">
        <TextBlock x:Name="TitleText" x:Uid="Pleylist" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="12">

                <TextBlock x:Name="PlaylistHeader" x:Uid="Pleylisty" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="PlaylistHint"
                           x:Uid="Kanaly_V_Spiske_Iz_Aktivnogo_Pleylista_2"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <ItemsControl x:Name="PlaylistsList" ItemsSource="{x:Bind PlaylistItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:PlaylistListItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Обычный вид: имя + URL. -->
                                    <StackPanel Grid.Column="0" Spacing="2"
                                                Visibility="{x:Bind ViewVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="●" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource SystemAccentColor}"
                                                       Visibility="{x:Bind ActiveMarkVisibility}"/>
                                            <TextBlock Text="{x:Bind Playlist.Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- URL плейлиста в списке не показываем:
                                             ссылка с ключом портала — секрет. -->
                                    </StackPanel>
                                    <!-- Режим переименования: поле имени + сохранение. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind EditVisibility}">
                                        <TextBox x:Name="NameEditBox" Width="260" KeyDown="NameEditBox_KeyDown"/>
                                        <Button Width="36" Height="32"
                                                x:Uid="Sokhranit_Imya"
                                                Click="SavePlaylistNameButton_Click">
                                            <Path Data="M2.5,8.5 L5,11 L13,3.5 L14.5,5 L5,14 L1,10 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="36" Height="32"
                                            x:Uid="Pereimenovat"
                                            Click="RenamePlaylistButton_Click"
                                            Visibility="{x:Bind ViewVisibility}">
                                            <Path Data="M2,14 L3.5,10.5 L11,3 L13,5 L5.5,12.5 Z M11.8,2.2 L13.8,4.2 L15,3 L13,1 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </Button>
                                    <Button Grid.Column="2" Content="EPG" Height="32" MinWidth="44" Padding="8,0"
                                            x:Uid="Istochniki_EPG_Etogo_Pleylista"
                                            Click="EpgSectionButton_Click"/>
                                    <Button Grid.Column="3" Width="36" Height="32"
                                            x:Uid="Aktivirovat"
                                            Click="ActivatePlaylistButton_Click"
                                            Visibility="{x:Bind ActivateButtonVisibility}">
                                            <Path Data="M2.5,8.5 L5,11 L13,3.5 L14.5,5 L5,14 L1,10 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </Button>
                                    <Button Grid.Column="4" Width="36" Height="32"
                                            x:Uid="Udalit"
                                            Click="RemovePlaylistButton_Click"
                                            Visibility="{x:Bind ViewVisibility}">
                                            <Path Data="M3,3.8 L4.1,2.7 L8,6.6 L11.9,2.7 L13,3.8 L9.1,7.7 L13,11.6 L11.9,12.7 L8,8.8 L4.1,12.7 L3,11.6 L6.9,7.7 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" Width="12" Height="12" />
                                        </Button>
                                </Grid>

                                <!-- Источники EPG этого плейлиста (раскрывается кнопкой EPG):
                                     чекбокс — использовать, корзина — удалить (с подтверждением
                                     в отдельном окне), снизу добавление по «+». -->
                                <StackPanel Spacing="6" Margin="0,8,0,0"
                                            Visibility="{x:Bind EpgSectionVisibility}">
                                    <ItemsControl ItemsSource="{x:Bind Playlist.EpgSources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EPGSource">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Checked="PlaylistEpgSource_CheckedChanged"
                                                              Unchecked="PlaylistEpgSource_CheckedChanged"
                                                              x:Uid="Ispolzovat_Istochnik"/>
                                                    <TextBlock Text="{x:Bind Url}" FontSize="11" Width="260"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Width="32" Height="32"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch"
                                                            x:Uid="Udalit_Istochnik"
                                                            Click="PlaylistEpgSourceRemoveButton_Click">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="296" PlaceholderText="URL XMLTV"
                                                 KeyDown="PlaylistEpgUrlBox_KeyDown"/>
                                        <Button Width="36" Height="32"
                                                VerticalAlignment="Center"
                                                x:Uid="Dobavit_Istochnik_EPG"
                                                Click="PlaylistEpgSourceAddButton_Click">
                                            <Path Data="M8,2 H9.5 V7 H14.5 V8.5 H9.5 V13.5 H8 V8.5 H3 V7 H8 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </Border>                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Статус действий над плейлистами — рядом со списком. -->
                <TextBlock x:Name="PlaylistStatusText"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="AddPlaylistHeader" x:Uid="Dobavit_Pleylist" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="PlaylistTypeCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="PlaylistTypeCombo_SelectionChanged"/>
                <TextBox x:Name="PlaylistNameBox"
                         x:Uid="Imya_Neobyazatelno"
                         HorizontalAlignment="Stretch"/>
                <TextBox x:Name="PlaylistUrlBox"
                         x:Uid="URL_Pleylista_M3U_M3U8"
                         HorizontalAlignment="Stretch"/>
                <!-- Поле ключа — только для типа «Видео-портал». -->
                <TextBox x:Name="PortalKeyBox"
                         x:Uid="Klyuch_Portala"
                         HorizontalAlignment="Stretch"
                         Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddPlaylistButton"
                            x:Uid="Dobavit"
                            HorizontalAlignment="Left"
                            Click="AddPlaylistButton_Click"/>
                    <Button x:Name="AddPlaylistFileButton"
                            x:Uid="Vybrat_Fayl"
                            HorizontalAlignment="Left"
                            Click="AddPlaylistFileButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="PlaylistRefreshHeader" x:Uid="CHastota_Obnovleniya_Pleylistov" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock x:Name="PlaylistRefreshHint"
                           x:Uid="Kak_Chasto_Pri_Zapuske_Perekachivat_Aktivnyy"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="PlaylistRefreshCombo" HorizontalAlignment="Stretch"/>

                <!-- Экспорт/импорт настроек: перенос между машинами (секреты в
                     settings.json зашифрованы DPAPI и копированием не
                     переносятся); файл экспорта защищён паролем. -->
                <TextBlock x:Name="TransferHeader" x:Uid="Perenos_Nastroek" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ExportSettingsButton"
                            x:Uid="Eksportirovat"
                            Click="ExportSettingsButton_Click"/>
                    <Button x:Name="ImportSettingsButton"
                            x:Uid="Importirovat"
                            Click="ImportSettingsButton_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки вне ScrollViewer: видны всегда, не уезжают при прокрутке. -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CloseButton"
                    x:Uid="Gotovo"
                    Width="100" Height="36"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
