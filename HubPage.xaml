<Page
    x:Class="IptvPlayer.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="HubBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF6F8FB" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#FFF6F8FB" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HubCardGradient" StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#30000000" Offset="0"/>
                        <GradientStop Color="#10000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HubCardBorderBrush" Color="#20000000"/>
                    <SolidColorBrush x:Key="HubCardBorderHoverBrush" Color="#50000000"/>
                    <SolidColorBrush x:Key="HubCardPlaylistsBrush" Color="#FFD9E4F2"/>
                    <SolidColorBrush x:Key="HubCardPortalBrush" Color="#FFD8EBDD"/>
                    <SolidColorBrush x:Key="HubCardSettingsBrush" Color="#FFE8DFF2"/>
                    <SolidColorBrush x:Key="HubCardVideoBrush" Color="#FFF2E4D7"/>
                    <SolidColorBrush x:Key="HubRoundBtnBrush" Color="#20000000"/>
                    <SolidColorBrush x:Key="HubRoundBtnBorderBrush" Color="#40000000"/>
                    <SolidColorBrush x:Key="HubRoundBtnHoverBrush" Color="#35000000"/>
                    <SolidColorBrush x:Key="HubRoundBtnHoverBorderBrush" Color="#80000000"/>
                    <SolidColorBrush x:Key="HubRoundBtnPressedBrush" Color="#45000000"/>
                    <SolidColorBrush x:Key="HubFgBrush" Color="#F0000000"/>
                    <SolidColorBrush x:Key="HubFgSoftBrush" Color="#B3000000"/>
                    <SolidColorBrush x:Key="HubFgSemiBrush" Color="#E6000000"/>
                    <SolidColorBrush x:Key="HubFlyoutBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubFlyoutBorderBrush" Color="#20000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="HubBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0D1117" Offset="0"/>
                        <GradientStop Color="#FF161B22" Offset="0.5"/>
                        <GradientStop Color="#FF0D1117" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HubCardGradient" StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HubCardBorderBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="HubCardBorderHoverBrush" Color="#50FFFFFF"/>
                    <SolidColorBrush x:Key="HubCardPlaylistsBrush" Color="#FF303A47"/>
                    <SolidColorBrush x:Key="HubCardPortalBrush" Color="#FF1A3A2A"/>
                    <SolidColorBrush x:Key="HubCardSettingsBrush" Color="#FF2A2030"/>
                    <SolidColorBrush x:Key="HubCardVideoBrush" Color="#FF3A2A20"/>
                    <SolidColorBrush x:Key="HubRoundBtnBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="HubRoundBtnBorderBrush" Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="HubRoundBtnHoverBrush" Color="#35FFFFFF"/>
                    <SolidColorBrush x:Key="HubRoundBtnHoverBorderBrush" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="HubRoundBtnPressedBrush" Color="#45FFFFFF"/>
                    <SolidColorBrush x:Key="HubFgBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HubFgSoftBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="HubFgSemiBrush" Color="#E6FFFFFF"/>
                    <SolidColorBrush x:Key="HubFlyoutBrush" Color="#FF1C2128"/>
                    <SolidColorBrush x:Key="HubFlyoutBorderBrush" Color="#30FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Карточка раздела: подъём при наведении + градиентная подсветка.
                 Цвета фона/рамок — тема-зависимые (выше). -->
            <Style x:Key="HubCard" TargetType="Button">
                <Setter Property="Width" Value="280"/>
                <Setter Property="Height" Value="220"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource HubCardBorderBrush}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="24"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="Transform" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="HoverOverlay"
                                            CornerRadius="16"
                                            Opacity="0"
                                            Background="{ThemeResource HubCardGradient}"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Transform.ScaleX" Value="1.05"/>
                                                <Setter Target="Transform.ScaleY" Value="1.05"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource HubCardBorderHoverBrush}"/>
                                                <Setter Target="HoverOverlay.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Круглая иконка-кнопка (кнопка «Справка»): подсветка при наведении -->
            <Style x:Key="HubRoundButton" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Background" Value="{ThemeResource HubRoundBtnBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource HubRoundBtnBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="22"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="T"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="B.Background" Value="{ThemeResource HubRoundBtnHoverBrush}"/>
                                                <Setter Target="B.BorderBrush" Value="{ThemeResource HubRoundBtnHoverBorderBrush}"/>
                                                <Setter Target="T.ScaleX" Value="1.08"/>
                                                <Setter Target="T.ScaleY" Value="1.08"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="B.Background" Value="{ThemeResource HubRoundBtnPressedBrush}"/>
                                                <Setter Target="T.ScaleX" Value="0.95"/>
                                                <Setter Target="T.ScaleY" Value="0.95"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HubBackground}" x:Name="RootGrid">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    x:Name="MainPanel" Opacity="0">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40"
                        x:Name="HeaderPanel">
                <TextBlock x:Name="GreetingText"
                           FontSize="48" FontWeight="Bold"
                           Foreground="{ThemeResource HubFgBrush}"
                           HorizontalAlignment="Center"/>
                <Border x:Name="AccentLine"
                        HorizontalAlignment="Center"
                        Height="2" Width="200"
                        CornerRadius="1"
                        Background="#FF6CA0"
                        Margin="0,10,0,0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="AccentLineTransform" ScaleX="0"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock x:Name="SubText"
                           FontSize="18"
                           Foreground="{ThemeResource HubFgSoftBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid HorizontalAlignment="Center" x:Name="CardsPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            <!-- Плейлисты: клавиша 1 -->
            <Button x:Name="PlaylistsButton" Grid.Column="0"
                    Click="PlaylistsButton_Click"
                    Style="{StaticResource HubCard}"
                    Background="{ThemeResource HubCardPlaylistsBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    AutomationProperties.AutomationId="HubPlaylistsCard">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number1" Invoked="PlaylistsAccelerator_Invoked"/>
                </Button.KeyboardAccelerators>
                <Button.RenderTransform>
                    <CompositeTransform x:Name="PlaylistsTransform" Rotation="-180" ScaleX="0.3" ScaleY="0.3"/>
                </Button.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="56" Height="56" Margin="0,0,0,16">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/playlists.svg"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Uid="Pleylisty" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubFgBrush}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    <TextBlock x:Uid="Upravlyayte_Pleylistami" FontSize="12"
                               Foreground="{ThemeResource HubFgSoftBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
            </Button>

            <!-- Портал: клавиша 2 -->
            <Button x:Name="PortalButton" Grid.Column="2"
                    Click="PortalButton_Click"
                    Style="{StaticResource HubCard}"
                    Background="{ThemeResource HubCardPortalBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    AutomationProperties.AutomationId="HubPortalCard">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number2" Invoked="PortalAccelerator_Invoked"/>
                </Button.KeyboardAccelerators>
                <Button.RenderTransform>
                    <CompositeTransform x:Name="PortalTransform" Rotation="180" ScaleX="0.3" ScaleY="0.3"/>
                </Button.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="56" Height="56" Margin="0,0,0,16">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/portal.svg"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Uid="Portal" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubFgBrush}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    <TextBlock x:Uid="Portal_Card_Subtitle" FontSize="12"
                               Foreground="{ThemeResource HubFgSoftBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
            </Button>

            <!-- Настройки: клавиша 4 -->
            <Button x:Name="SettingsButton" Grid.Column="6"
                    Click="SettingsButton_Click"
                    Style="{StaticResource HubCard}"
                    Background="{ThemeResource HubCardSettingsBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    AutomationProperties.AutomationId="HubSettingsCard">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number4" Invoked="SettingsAccelerator_Invoked"/>
                </Button.KeyboardAccelerators>
                <Button.RenderTransform>
                    <CompositeTransform x:Name="SettingsTransform" Rotation="-180" ScaleX="0.3" ScaleY="0.3"/>
                </Button.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="56" Height="56" Margin="0,0,0,16">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/settings.svg"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Uid="Nastroyki_Card" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubFgBrush}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    <TextBlock x:Uid="Yazyk_Interfeys_Vosproizv" FontSize="12"
                               Foreground="{ThemeResource HubFgSoftBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
            </Button>

            <!-- Видео (локальные файлы): клавиша 3 -->
            <Button x:Name="VideoButton" Grid.Column="4"
                    Click="VideoButton_Click"
                    Style="{StaticResource HubCard}"
                    Background="{ThemeResource HubCardVideoBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    AutomationProperties.AutomationId="HubVideoCard">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number3" Invoked="VideoAccelerator_Invoked"/>
                </Button.KeyboardAccelerators>
                <Button.RenderTransform>
                    <CompositeTransform x:Name="VideoTransform" Rotation="180" ScaleX="0.3" ScaleY="0.3"/>
                </Button.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="{ThemeResource HubFgBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock x:Uid="Video_Card" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubFgBrush}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    <TextBlock x:Uid="Video_Card_Subtitle" FontSize="12"
                               Foreground="{ThemeResource HubFgSoftBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
            </Button>
            </Grid>

            <!-- Плашка «Продолжить просмотр» — последний недосмотренный VOD -->
            <Button x:Name="ContinueButton"
                    Visibility="Collapsed"
                    Click="ContinueButton_Click"
                    HorizontalAlignment="Center"
                    Margin="0,36,0,0"
                    Padding="20,12,20,12"
                    CornerRadius="12"
                    Background="#25FF6CA0"
                    BorderBrush="#60FF6CA0"
                    BorderThickness="1"
                    Opacity="0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FF6CA0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ContinueText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubFgSemiBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Overlay для закрытия flyout: ловит нажатие любой кнопки мыши -->
        <Border x:Name="FlyoutOverlay" Background="Transparent"
                Visibility="Collapsed" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" MinHeight="0" MinWidth="0"
                PointerPressed="FlyoutOverlay_PointerPressed"/>

        <!-- Кнопка «Справка» в правом нижнем углу: горячие клавиши приложения -->
        <Button x:Name="InfoButton"
                Click="InfoButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Style="{StaticResource HubRoundButton}"
                AutomationProperties.AutomationId="HubInfoButton">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="F1" Invoked="InfoAccelerator_Invoked"/>
            </Button.KeyboardAccelerators>
            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{ThemeResource HubFgSemiBrush}"/>
        </Button>

        <!-- Кастомный flyout -->
        <Border x:Name="FlyoutBorder"
                Background="{ThemeResource HubFlyoutBrush}"
                BorderBrush="{ThemeResource HubFlyoutBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4"
                MinWidth="280"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <CompositeTransform x:Name="FlyoutTransform" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ScrollViewer x:Name="FlyoutScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FlyoutContent" Spacing="2"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
