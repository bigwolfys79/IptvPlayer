                    <TextBlock Grid.Row="0" x:Name="OverlayChannelsHeaderText" x:Uid="Kanaly"
                               Foreground="{ThemeResource OverlayFgBrush}" FontSize="18" FontWeight="SemiBold"
                               Padding="16,16,16,8" />

                    <ListView x:Name="OverlayChannelsListView"
                              Grid.Row="1"
                              Background="Transparent"
                              ItemsSource="{x:Bind ViewModel.DisplayedChannels, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="ChannelsListView_ItemClick"
                              ItemTemplate="{StaticResource ChannelItemTemplate}">
                        <ListView.Resources>
                            <ResourceDictionary>
                                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ChannelSelectedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ChannelSelectedHoverBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ChannelSelectedPressedBrush"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White"/>
                            </ResourceDictionary>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource OverlayScrimBrush}" Padding="16,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                                <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayPrevChannelButton"
                                                                Width="56" Height="56"
                                                                Command="{x:Bind ViewModel.GoToPreviousChannelCommand}"
                                                                x:Uid="Predydushchiy_Kanal_Backspace">
                                                    <Path Data="M16,5 L7,11 L16,17 Z" Fill="{ThemeResource OverlayFgBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayRecordButton"
                                                                Width="56" Height="56"
                                                                Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                                                                x:Uid="Zapisat_Kanal">
                                                    <Ellipse Width="18" Height="18" Fill="{ThemeResource RecRedBrush}" />
                                                </Button>
                                                <Button x:Name="OverlayBackToLiveButton"
                                                                x:Uid="V_Efir"
                                                                FontSize="12"
                                                                Padding="12,4"
                                                                Visibility="Collapsed"
                                                                Command="{x:Bind ViewModel.BackToLiveCommand}"
                                                                />
                                                <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayPauseButton"
                                                                Width="56" Height="56"
                                                                Command="{x:Bind ViewModel.ToggleArchivePauseCommand}"
                                                                Visibility="Collapsed"
                                                                x:Uid="Pauza_Arkhiv">
                                                    <Path Data="M3.5,2.5 H6.4 V13.5 H3.5 Z M9.6,2.5 H12.5 V13.5 H9.6 Z"
                                                          Width="20" Height="20" Stretch="Uniform" Fill="{ThemeResource OverlayFgBrush}" />
                                                </Button>
                        <StackPanel x:Name="OverlayArchiveSeekPanel"
                                    Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    x:Uid="Peremotka_Arkhiva_Otpustite_Polzunok_Dlya_Perekhoda">
                            <TextBlock x:Name="OverlayArchivePositionText"
                                       Text="00:00" FontSize="12" Foreground="{ThemeResource OverlayFgSoftBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="OverlayArchiveSeekBar"
                                    Width="190" Minimum="0" Maximum="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="ArchiveSeekBar_ValueChanged"
                                    PointerPressed="ArchiveSeekBar_PointerPressed"
                                    PointerReleased="ArchiveSeekBar_PointerReleased"
                                    PointerCaptureLost="ArchiveSeekBar_PointerCaptureLost" />
                            <TextBlock x:Name="OverlayArchiveDurationText"
                                       Text="00:00" FontSize="12" Foreground="{ThemeResource OverlayFgSoftBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="OverlayVodSeekPanel"
                                    Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    x:Uid="Peremotka_Video_Otpustite_Polzunok">
                            <TextBlock x:Name="OverlayVodPositionText"
                                       Text="00:00" FontSize="12" Foreground="{ThemeResource OverlayFgSoftBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="OverlayVodSeekBar"
                                    Width="190" Minimum="0" Maximum="1"
                                    ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                                    VerticalAlignment="Center"
                                    ValueChanged="VodSeekBar_ValueChanged"
                                    PointerPressed="VodSeekBar_PointerPressed"
                                    PointerReleased="VodSeekBar_PointerReleased"
                                    PointerCaptureLost="VodSeekBar_PointerCaptureLost" />
                            <TextBlock x:Name="OverlayVodDurationText"
                                       Text="00:00" FontSize="12" Foreground="{ThemeResource OverlayFgSoftBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    <ComboBox x:Name="OverlayVodSeasonCombo"
                              Width="120" FontSize="12"
                              Visibility="Collapsed"
                              SelectionChanged="VodSeasonCombo_SelectionChanged"
                              x:Uid="Sezon_2" />
                    <ComboBox x:Name="OverlayVodEpisodeCombo"
                              Width="150" FontSize="12"
                              Visibility="Collapsed"
                              SelectionChanged="VodEpisodeCombo_SelectionChanged"
                              x:Uid="Seriya" />
                    <Button x:Name="OverlayVodQualityButton"
                            x:Uid="Avto" FontSize="12" Padding="12,4" MinWidth="56"
                            Visibility="Collapsed"
                            />
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayMuteButton"
                            Width="40" Height="40"
                            Margin="16,0,0,0"
                            Click="MuteButton_Click"
                            x:Uid="Bez_Zvuka_M" />
                    <Slider x:Name="OverlayVolumeSlider"
                            Width="150"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            VerticalAlignment="Center"
                            ValueChanged="OverlayVolumeSlider_ValueChanged" />
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayStretchButton"
                            Width="44" Height="44"
                            Click="StretchButton_Click"
                            x:Uid="Rezhim_Otobrazheniya_V">
                        <Grid Width="18" Height="18">
                            <Rectangle Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3" RadiusX="2" RadiusY="2"
                                       Margin="1,2.4,1,1" />
                            <Path Data="M4,8 H12 M5.8,5.6 L3.4,8 L5.8,10.4 M10.2,5.6 L12.6,8 L10.2,10.4"
                                  Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.2" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayUpscalerButton"
                            Width="44" Height="44"
                            x:Uid="Kachestvo_Kartinki">
                        <Path Data="M8,1 L9.6,6.4 L15,8 L9.6,9.6 L8,15 L6.4,9.6 L1,8 L6.4,6.4 Z"
                              Fill="{ThemeResource OverlayFgBrush}" Stretch="Uniform" Width="16" Height="16" />
                        <Button.Flyout>
                            <MenuFlyout Opening="UpscalerMenu_Opening">
                                <RadioMenuFlyoutItem x:Name="OverlayUpscalerOffItem" Tag="Off"
                                                     GroupName="OverlayUpscalerMenu" Click="UpscalerItem_Click"
                                                     x:Uid="Usilitel_Vyklyuch"/>
                                <RadioMenuFlyoutItem x:Name="OverlayUpscalerSharpItem" Tag="Sharp"
                                                     GroupName="OverlayUpscalerMenu" Click="UpscalerItem_Click"
                                                     x:Uid="Usilitel_Rezkost"/>
                                <RadioMenuFlyoutItem x:Name="OverlayUpscalerDenoiseItem" Tag="Denoise"
                                                     GroupName="OverlayUpscalerMenu" Click="UpscalerItem_Click"
                                                     x:Uid="Usilitel_Chistka"/>
                                <RadioMenuFlyoutItem x:Name="OverlayUpscalerSdItem" Tag="SdUpscale"
                                                     GroupName="OverlayUpscalerMenu" Click="UpscalerItem_Click"
                                                     x:Uid="Usilitel_SD"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Name="OverlayFrameServerItem"
                                                     Click="FrameServerItem_Click"
                                                     x:Uid="Usilitel_Render_Eks"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlaySleepTimerButton"
                            Width="44" Height="44"
                            Click="SleepTimerButton_Click"
                            x:Uid="Taymer_Sna">
                        <Grid Width="18" Height="18">
                            <Path Data="M8,1.5 A6.5,6.5 0 1 0 14.5,8"
                                  Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3" Fill="Transparent" />
                            <Path Data="M8,4 V8 L11,10"
                                  Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3" />
                            <Path Data="M12.8,10.2 A5.6,5.6 0 1 1 6,2.4 A4.5,4.5 0 1 0 12.8,10.2 Z"
                                  Fill="#B39DDB" Stretch="Uniform"
                                  Width="7" Height="7"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,-1,-1" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayEpgButton"
                            Width="44" Height="44"
                            Command="{x:Bind ViewModel.ToggleEpgCommand}"
                            x:Uid="Pokazat_Skryt_EPG">
                        <Grid Width="17" Height="17">
                            <Rectangle Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3" RadiusX="2" RadiusY="2"
                                       Margin="1,2.6,1,1" />
                            <Rectangle Fill="{ThemeResource OverlayFgBrush}" Height="1.7" RadiusX="0.8"
                                       Margin="1,5.6,1,0" VerticalAlignment="Top" />
                            <Rectangle Fill="{ThemeResource OverlayFgBrush}" Width="2.4" Height="4.4" RadiusX="1.2"
                                       Margin="3.7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Rectangle Fill="{ThemeResource OverlayFgBrush}" Width="2.4" Height="4.4" RadiusX="1.2"
                                       Margin="0,0,3.7,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="OverlayAlwaysOnTopButton"
                            Width="44" Height="44"
                            Click="ToggleAlwaysOnTop"
                            x:Uid="Poverkh_Vsekh_Okon_Vkl">
                        <Grid Width="18" Height="18">
                            <Rectangle Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3"
                                       Margin="1,1,5,5" Opacity="0.55" />
                            <Rectangle Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.3"
                                       Fill="{ThemeResource OverlayScrimBrush}"
                                       Margin="5,5,1,1" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" x:Name="ExitFullScreenButton"
                            Width="44" Height="44"
                            Click="ExitFullScreenButton_Click"
                            x:Uid="Vyyti_Iz_Polnoekrannogo_Rezhima">
                        <Path Data="M5.5,1 V3 Q5.5,5 3.5,5 H1 M15,5 H12.5 Q10.5,5 10.5,3 V1 M10.5,15 V13 Q10.5,11 12.5,11 H15 M1,11 H3.5 Q5.5,11 5.5,13 V15"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{ThemeResource OverlayFgBrush}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatsOverlay"
                Grid.Column="2"
                Canvas.ZIndex="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12,60,0,0"
                Padding="14,10"
                CornerRadius="8"
                Background="{ThemeResource OverlayScrimBrush}"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatsText"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="#FFE8E8E8"
                       Text="—" />
        </Border>

        <Border Grid.ColumnSpan="3"
                Canvas.ZIndex="50"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsPlaylistLoading, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
                <ProgressRing Width="48" Height="48"
                              IsActive="{x:Bind ViewModel.IsPlaylistLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.PlaylistLoadingText, Mode=OneWay}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </ictrl:CursorGrid>
</Page>
